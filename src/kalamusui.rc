<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="kalamus" version="2">
    <MenuBar>
        <Menu name="file">
            <Action name="file_open_folder" append="open_merge"/>
            <Menu name="file_export" append="save_merge">
                <text>E&amp;xport</text>
                <Action name="file_export_html"/>
                <Action name="file_export_pdf"/>
                <Separator/>
                <Action name="file_export_docx"/>
                <Action name="file_export_odt"/>
            </Menu>
        </Menu>
        <Menu name="format">
            <text>F&amp;ormat</text>
            <Action name="format_bold"/>
            <Action name="format_italic"/>
            <Action name="format_strikethrough"/>
            <Action name="format_code"/>
            <Action name="format_link"/>
            <Separator/>
            <Action name="format_paragraph"/>
            <Action name="format_heading_1"/>
            <Action name="format_heading_2"/>
            <Action name="format_heading_3"/>
            <Action name="format_heading_4"/>
            <Action name="format_heading_5"/>
            <Action name="format_heading_6"/>
            <Separator/>
            <Menu name="format_table">
                <text>&amp;Table</text>
                <Action name="table_insert"/>
                <Separator/>
                <Action name="table_row_below"/>
                <Action name="table_column_after"/>
                <Action name="table_delete_row"/>
                <Action name="table_delete_column"/>
                <Separator/>
                <Action name="table_align_left"/>
                <Action name="table_align_center"/>
                <Action name="table_align_right"/>
                <Separator/>
                <Action name="table_format"/>
            </Menu>
        </Menu>
        <Menu name="view">
            <Action name="view_toggle_files"/>
        </Menu>
    </MenuBar>
    <ToolBar name="mainToolBar">
        <text>Main Toolbar</text>
        <Action name="file_new"/>
        <Action name="file_open"/>
        <Action name="file_open_folder"/>
        <Action name="file_save"/>
        <Separator/>
        <Action name="format_bold"/>
        <Action name="format_italic"/>
        <Action name="format_strikethrough"/>
        <Action name="format_code"/>
        <Action name="format_link"/>
        <Action name="table_insert"/>
    </ToolBar>
</gui>
