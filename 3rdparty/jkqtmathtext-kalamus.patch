+namespace {
+    // Kalamus patch: a + or - that starts an expression (-1, x^{-1}, (-y), a = -b) is a sign,
+    // not a binary operator, so it gets no operator spacing (as in TeX).
+    bool isUnarySign(const JKQTMathTextNode* node, const QString& symbolName) {
+        if (symbolName!="-" && symbolName!="+") return false;
+        const auto* list=dynamic_cast<const JKQTMathTextHorizontalListNode*>(node->getParentNode());
+        if (!list) return true;
+        int index=-1;
+        for (int i=0; i<list->childCount(); i++) {
+            if (list->getChild(i)==node) { index=i; break; }
+        }
+        if (index<0) return false; // not found (the tree was rearranged): treat as an operator
+        if (index==0) return true;
+        const JKQTMathTextNode* previous=list->getChild(index-1);
+        if (dynamic_cast<const JKQTMathTextSymbolNode*>(previous)) {
+            const QString name=static_cast<const JKQTMathTextSymbolNode*>(previous)->getSymbolName();
+            return name=="=" || name=="+" || name=="-" || name=="<" || name==">" || name=="*";
+        }
+        if (const auto* text=dynamic_cast<const JKQTMathTextTextNode*>(previous)) {
+            const QString t=text->getText().trimmed();
+            return t.isEmpty() || QString("([{,;").contains(t.back());
+        }
+        return false;
+    }
+}
